// =============================================================================
// DukaanSync — Cloud Firestore Security Rules
// =============================================================================
// Enforces strict multi-tenant and multi-shop data isolation.
// Every subcollection under a shop requires canAccessShop() authorization.
// Database rules are the source of truth — client-side ShopContext is purely
// a UI convenience.
// =============================================================================

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Helper Functions
    // =========================================================================

    /// Check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    /// Check if request is from seed admin maintenance account
    function isSeedAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "seed.admin@metromart.com" ||
        request.auth.uid == "QhlEJoMLs0geF2lZB8k9wokL0PJ3"
      );
    }

    /// Check if the authenticated user is a member of the given business
    function isBusinessMember(businessId) {
      return isAuthenticated()
        && (
          isSeedAdmin()
          || exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid))
        );
    }

    /// Check if the authenticated user is the owner of the given business
    function isBusinessOwner(businessId) {
      return isAuthenticated()
        && (
          isSeedAdmin()
          || get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid
        );
    }

    /// Get the member document for the current user in the given business
    function getMember(businessId) {
      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data;
    }

    /// Check if the user can access a specific shop within a business
    /// Owners can access all shops; other members need the shopId in their shopIds array
    function canAccessShop(businessId, shopId) {
      return isBusinessMember(businessId)
        && (
          isSeedAdmin()
          || isBusinessOwner(businessId)
          || shopId in getMember(businessId).shopIds
        );
    }

    /// Enforce immutable system fields on write
    function isValidTenantWrite(businessId, shopId) {
      // Allow if businessId and shopId aren't present (some docs don't embed them redundantly since they are in path)
      // Or if they are present, they must match the path.
      return (!('businessId' in request.resource.data) || request.resource.data.businessId == businessId)
          && (!('shopId' in request.resource.data) || request.resource.data.shopId == shopId)
          && (resource == null || !('createdBy' in request.resource.data) || request.resource.data.createdBy == resource.data.createdBy);
    }

    // =========================================================================
    // Global: Block all access by default (no wildcard catch-all)
    // =========================================================================

    // =========================================================================
    // Users Collection — /users/{uid}
    // =========================================================================
    match /users/{uid} {
      // Users can read/write their profile; seed admin can align business IDs
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == uid || isSeedAdmin());
    }

    // =========================================================================
    // Businesses Collection — /businesses/{businessId}
    // =========================================================================
    match /businesses/{businessId} {
      // Only members can read the business document
      allow read: if isBusinessMember(businessId);

      // Allow authenticated user to create a business if they are the owner
      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;

      // Allow owner or business members to update business settings
      allow update: if isAuthenticated()
        && (
          isSeedAdmin()
          || resource.data.ownerId == request.auth.uid
          || isBusinessMember(businessId)
        );

      // Only the owner or seed admin can delete business settings
      allow delete: if isAuthenticated()
        && (
          isSeedAdmin()
          || resource.data.ownerId == request.auth.uid
        );

      // -----------------------------------------------------------------------
      // Business Members — /businesses/{businessId}/members/{uid}
      // -----------------------------------------------------------------------
      match /members/{uid} {
        // Members of the business (and owners/admin) can read member records
        allow read: if isAuthenticated()
          && (
            isSeedAdmin()
            || request.auth.uid == uid
            || isBusinessMember(businessId)
            || isBusinessOwner(businessId)
          );

        // Allow creating initial member during onboarding batch write (when uid == request.auth.uid) or by owner
        allow create: if isAuthenticated() && (request.auth.uid == uid || isBusinessOwner(businessId));

        // Only owners can update or delete members
        allow update, delete: if isBusinessOwner(businessId);
      }

      // -----------------------------------------------------------------------
      // Business-Level Customers — /businesses/{businessId}/customers/{document=**}
      // -----------------------------------------------------------------------
      match /customers/{document=**} {
        allow read, write: if isBusinessMember(businessId);
      }

      // -----------------------------------------------------------------------
      // Business-Level Suppliers — /businesses/{businessId}/suppliers/{document=**}
      // -----------------------------------------------------------------------
      match /suppliers/{document=**} {
        allow read, write: if isBusinessMember(businessId);
      }

      // -----------------------------------------------------------------------
      // Business-Level Audit Logs — /businesses/{businessId}/auditLogs/{document=**}
      // -----------------------------------------------------------------------
      match /auditLogs/{document=**} {
        allow read, create: if isBusinessMember(businessId);
        allow update, delete: if false;
      }

      // -----------------------------------------------------------------------
      // Shops — /businesses/{businessId}/shops/{shopId}
      // -----------------------------------------------------------------------
      match /shops/{shopId} {
        // Any authenticated member of the business can read shop definitions
        allow read: if isAuthenticated()
          && (
            isSeedAdmin()
            || isBusinessMember(businessId)
            || isBusinessOwner(businessId)
            || canAccessShop(businessId, shopId)
          );

        // Allow shop creation during onboarding batch write by authenticated users or business owner
        allow create: if isAuthenticated();

        // Only owners can update or delete shops
        allow update, delete: if isBusinessOwner(businessId);

        // =====================================================================
        // Shop Subcollections — All require canAccessShop()
        // =====================================================================

        match /inventory/{document=**} {
          allow read, write: if canAccessShop(businessId, shopId);
        }

        match /sales/{document=**} {
          allow read: if canAccessShop(businessId, shopId);
          allow write: if canAccessShop(businessId, shopId)
            && getMember(businessId).role in ['owner', 'manager', 'cashier'];
        }

        match /purchases/{document=**} {
          allow read: if canAccessShop(businessId, shopId);
          allow write: if canAccessShop(businessId, shopId)
            && getMember(businessId).role in ['owner', 'manager'];
        }

        match /customers/{document=**} {
          allow read: if canAccessShop(businessId, shopId);
          allow write: if canAccessShop(businessId, shopId)
            && getMember(businessId).role in ['owner', 'manager', 'cashier'];
        }

        match /suppliers/{document=**} {
          allow read: if canAccessShop(businessId, shopId);
          allow write: if canAccessShop(businessId, shopId)
            && getMember(businessId).role in ['owner', 'manager'];
        }

        match /expenses/{document=**} {
          allow read: if canAccessShop(businessId, shopId);
          allow write: if canAccessShop(businessId, shopId)
            && getMember(businessId).role in ['owner', 'manager'];
        }

        match /movements/{document=**} {
          allow read, create: if canAccessShop(businessId, shopId);
        }

        match /stockMovements/{document=**} {
          allow read, create: if canAccessShop(businessId, shopId);
        }

        match /customerLedger/{document=**} {
          allow read: if canAccessShop(businessId, shopId);
          allow write: if canAccessShop(businessId, shopId)
            && getMember(businessId).role in ['owner', 'manager', 'cashier'];
        }

        match /supplierLedger/{document=**} {
          allow read: if canAccessShop(businessId, shopId);
          allow write: if canAccessShop(businessId, shopId)
            && getMember(businessId).role in ['owner', 'manager'];
        }

        match /auditLogs/{document=**} {
          allow read: if isBusinessOwner(businessId);
          allow create: if canAccessShop(businessId, shopId) && request.resource.data.actorId == request.auth.uid;
          allow update, delete: if false;
        }
      }
    }
  }
}