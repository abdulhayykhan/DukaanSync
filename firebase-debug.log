[debug] [2026-08-11T04:02:47.070Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/dukaansync/rulesets {"name":"projects/dukaansync/rulesets/37592643-4728-48b3-80b1-37f0ef5688b3","source":{"files":[{"content":"// =============================================================================\n// DukaanSync — Cloud Firestore Security Rules\n// =============================================================================\n// Enforces strict multi-tenant and multi-shop data isolation.\n// Every subcollection under a shop requires canAccessShop() authorization.\n// Database rules are the source of truth — client-side ShopContext is purely\n// a UI convenience.\n// =============================================================================\n\nrules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // =========================================================================\n    // Helper Functions\n    // =========================================================================\n\n    /// Check if the request is from an authenticated user\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    /// Check if the authenticated user is a member of the given business\n    function isBusinessMember(businessId) {\n      return isAuthenticated()\n        && exists(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid));\n    }\n\n    /// Check if the authenticated user is the owner of the given business\n    function isBusinessOwner(businessId) {\n      return isAuthenticated()\n        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;\n    }\n\n    /// Get the member document for the current user in the given business\n    function getMember(businessId) {\n      return get(/databases/$(database)/documents/businesses/$(businessId)/members/$(request.auth.uid)).data;\n    }\n\n    /// Check if the user can access a specific shop within a business\n    /// Owners can access all shops; other members need the shopId in their shopIds array\n    function canAccessShop(businessId, shopId) {\n      return isBusinessMember(businessId)\n        && (\n          isBusinessOwner(businessId)\n          || shopId in getMember(businessId).shopIds\n        );\n    }\n\n    /// Enforce immutable system fields on write\n    function isValidTenantWrite(businessId, shopId) {\n      // Allow if businessId and shopId aren't present (some docs don't embed them redundantly since they are in path)\n      // Or if they are present, they must match the path.\n      return (!('businessId' in request.resource.data) || request.resource.data.businessId == businessId)\n          && (!('shopId' in request.resource.data) || request.resource.data.shopId == shopId)\n          && (resource == null || !('createdBy' in request.resource.data) || request.resource.data.createdBy == resource.data.createdBy);\n    }\n\n    // =========================================================================\n    // Global: Block all access by default (no wildcard catch-all)\n    // =========================================================================\n\n    // =========================================================================\n    // Users Collection — /users/{uid}\n    // =========================================================================\n    match /users/{uid} {\n      // Users can only read/write their own profile\n      allow read: if isAuthenticated() && request.auth.uid == uid;\n      allow write: if isAuthenticated() && request.auth.uid == uid;\n    }\n\n    // =========================================================================\n    // Businesses Collection — /businesses/{businessId}\n    // =========================================================================\n    match /businesses/{businessId} {\n      // Only members can read the business document\n      allow read: if isBusinessMember(businessId);\n\n      // Allow authenticated user to create a business if they are the owner\n      allow create: if isAuthenticated() && request.resource.data.ownerId == request.auth.uid;\n\n      // Only the owner can update or delete business settings\n      allow update, delete: if isBusinessOwner(businessId);\n\n      // -----------------------------------------------------------------------\n      // Business Members — /businesses/{businessId}/members/{uid}\n      // -----------------------------------------------------------------------\n      match /members/{uid} {\n        // Members can read their own record; owners can read all members\n        allow read: if isAuthenticated()\n          && (request.auth.uid == uid || isBusinessOwner(businessId));\n\n        // Allow creating initial member during onboarding batch write (when uid == request.auth.uid) or by owner\n        allow create: if isAuthenticated() && (request.auth.uid == uid || isBusinessOwner(businessId));\n\n        // Only owners can update or delete members\n        allow update, delete: if isBusinessOwner(businessId);\n      }\n\n      // -----------------------------------------------------------------------\n      // Shops — /businesses/{businessId}/shops/{shopId}\n      // -----------------------------------------------------------------------\n      match /shops/{shopId} {\n        // Members with shop access can read; owners can read all\n        allow read: if canAccessShop(businessId, shopId);\n\n        // Allow shop creation during onboarding batch write by authenticated users or business owner\n        allow create: if isAuthenticated();\n\n        // Only owners can update or delete shops\n        allow update, delete: if isBusinessOwner(businessId);\n\n        // =====================================================================\n        // Shop Subcollections — All require canAccessShop()\n        // =====================================================================\n\n        match /inventory/{document=**} {\n          allow read, write: if canAccessShop(businessId, shopId);\n        }\n\n        match /sales/{document=**} {\n          allow read: if canAccessShop(businessId, shopId);\n          allow write: if canAccessShop(businessId, shopId)\n            && getMember(businessId).role in ['owner', 'manager', 'cashier'];\n        }\n\n        match /purchases/{document=**} {\n          allow read: if canAccessShop(businessId, shopId);\n          allow write: if canAccessShop(businessId, shopId)\n            && getMember(businessId).role in ['owner', 'manager'];\n        }\n\n        match /customers/{document=**} {\n          allow read: if canAccessShop(businessId, shopId);\n          allow write: if canAccessShop(businessId, shopId)\n            && getMember(businessId).role in ['owner', 'manager', 'cashier'];\n        }\n\n        match /suppliers/{document=**} {\n          allow read: if canAccessShop(businessId, shopId);\n          allow write: if canAccessShop(businessId, shopId)\n            && getMember(businessId).role in ['owner', 'manager'];\n        }\n\n        match /expenses/{document=**} {\n          allow read: if canAccessShop(businessId, shopId);\n          allow write: if canAccessShop(businessId, shopId)\n            && getMember(businessId).role in ['owner', 'manager'];\n        }\n\n        match /stockMovements/{document=**} {\n          allow read, create: if canAccessShop(businessId, shopId);\n        }\n\n        match /customerLedger/{document=**} {\n          allow read: if canAccessShop(businessId, shopId);\n          allow write: if canAccessShop(businessId, shopId)\n            && getMember(businessId).role in ['owner', 'manager', 'cashier'];\n        }\n\n        match /supplierLedger/{document=**} {\n          allow read: if canAccessShop(businessId, shopId);\n          allow write: if canAccessShop(businessId, shopId)\n            && getMember(businessId).role in ['owner', 'manager'];\n        }\n\n        match /auditLogs/{document=**} {\n          allow read: if isBusinessOwner(businessId);\n          allow create: if canAccessShop(businessId, shopId) && request.resource.data.actorId == request.auth.uid;\n          allow update, delete: if false;\n        }\n      }\n    }\n  }\n}","name":"firestore.rules"}]},"createTime":"2026-08-11T04:02:45.093023Z","metadata":{"services":["cloud.firestore"]}}
